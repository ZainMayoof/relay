{
  "name": "relay-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Relay Section 1.2: Express server and MongoDB connection",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "test": "node --test test/connection.test.js test/equipment-security.test.js",
    "test:connection": "node --env-file=.env scripts/check-connection.js",
    "test:all": "node --test test/*.test.js",
    "test:equipment": "node --test test/equipment-integration.test.js",
    "bootstrap:admin": "node --env-file=.env scripts/bootstrap-admin.js"
  },
  "dependencies": {
    "argon2": "0.45.2",
    "express": "^5.1.0",
    "mongodb": "^6.16.0",
    "swagger-ui-express": "5.0.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.0.0",
    "mongodb-memory-server": "10.4.3"
  }
}
